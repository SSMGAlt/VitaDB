# Copy this file OUT of the repo, to the folder that contains VitaDB/, e.g.:
#   cp deploy/.env.example ../vitadb.env
#
# Then edit ../vitadb.env with real values and lock it down:
#   chmod 600 ../vitadb.env
#
# Never commit the filled-in file - it stays outside of git on purpose so
# `git reset --hard` (used by the auto-update system) can never touch it.

DB_NAME=vitadb
DB_USER=vitadb
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Must exactly match the "Secret" field you set on the GitHub webhook
WEBHOOK_SECRET=change-me-webhook-secret

# Branch that triggers an auto-deploy when pushed to
DEPLOY_BRANCH=master
