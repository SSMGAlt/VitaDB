{
  "root": true,
  "env": {
    "browser": true,
    "es2021": false,
    "jquery": true
  },
  "parserOptions": {
    "ecmaVersion": 2018,
    "sourceType": "script"
  },
  "globals": {
    "angular": "readonly",
    "alertify": "readonly"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": "warn",
    "no-empty": "warn",
    "no-console": "off"
  }
}
